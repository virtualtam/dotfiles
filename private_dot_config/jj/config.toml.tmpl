[user]
name = {{ .name | quote }}
email = {{ .email | quote }}

[aliases]
ds = ["diff", "--stat"]
dw = ["diff", "-w"]
lg = ["log", "-r", "::@", "-T", "builtin_log_oneline"]
lh = ["log", "-r", "::@", "-T", "builtin_log_detailed"]
lt = ["log", "-r", "::@", "-T", "builtin_log_oneline", "-n", "10"]
rt = ["git", "remote"]
sh = ["show"]
shst = ["show", "--stat"]

[colors]
"diff token" = { underline = false }

[templates]
commit_trailers = "format_signed_off_by_trailer(self)"
{{- if ne .gitSigningKey "" }}

[signing]
behavior = "drop"
backend = "gpg"
key = {{ .gitSigningKey | quote }}

[revsets]
git-sign-on-push = "~signed() & mine()"
{{- end }}
