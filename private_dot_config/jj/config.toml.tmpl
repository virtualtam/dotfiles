[user]
name = {{ .name | quote }}
email = {{ .email | quote }}

[colors]
"diff token" = { underline = false }

[templates]
commit_trailers = "format_signed_off_by_trailer(self)"
{{- if ne .gitSigningKey "" }}

[signing]
behavior = "drop"
backend = "gpg"
key = {{ .gitSigningKey | quote }}

[revsets]
git-sign-on-push = "~signed() & mine()"
{{- end }}
